    {
      "type": "replace",
      "target": "$indexed_requirements",
      "value": [
        {
          "index": 0,
          "replace": false,
          "requirements": [
            "caverns_and_chasms:armor_trimmed_caverns_and_chasms:exile_armor_trim_smithing_template_smithing_trim",
            "caverns_and_chasms:armor_trimmed_caverns_and_chasms:forger_armor_trim_smithing_template_smithing_trim",
            "caverns_and_chasms:armor_trimmed_caverns_and_chasms:immolate_armor_trim_smithing_template_smithing_trim",
