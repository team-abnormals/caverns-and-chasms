{
  "molding": "json",
  "remolder": [
    [
      {
        "type": "replace",
        "expressed_value": "display",
        "target": "$original_display"
      },
      {
        "type": "conditional",
        "!#isMap($original_display)": [
          {
            "type": "replace",
            "target": "$original_display",
            "value": {
              "description": "",
              "icon": {
                "count": 1,
                "id": "minecraft:stone"
              },
              "title": ""
            }
          },
          {
            "type": "replace",
            "expressed_value": "$original_display",
            "target": "display"
          }
        ]
      },
      {
        "type": "replace",
        "expressed_value": "#map($original_display)",
        "target": "$display"
      },
      {
        "type": "replace",
        "target": "$display[\"description\"]",
        "value": {
          "translate": "advancements.caverns_and_chasms.husbandry.wax_off.description"
        }
      }
    ],
    [
      {
        "type": "replace",
        "target": "$criteria",
        "value": {
          "caverns_and_chasms:wax_off_blocks": {
            "conditions": {
              "location": [
                {
                  "condition": "minecraft:location_check",
                  "predicate": {
                    "block": {
                      "blocks": "#c:waxed_copper_blocks"
                    }
                  }
                },
                {
                  "condition": "minecraft:match_tool",
                  "predicate": {
                    "items": "#minecraft:axes"
                  }
                }
              ]
            },
            "trigger": "minecraft:item_used_on_block"
          },
          "caverns_and_chasms:wax_off_golem": {
            "conditions": {
              "entity": [
                {
                  "condition": "minecraft:entity_properties",
                  "entity": "this",
                  "predicate": {
                    "type": "caverns_and_chasms:copper_golem"
                  }
                }
              ],
              "item": {
                "items": "#minecraft:axes"
              }
            },
            "trigger": "minecraft:player_interacted_with_entity"
          },
          "caverns_and_chasms:wax_off_oxidized_golem": {
            "conditions": {
              "entity": [
                {
                  "condition": "minecraft:entity_properties",
                  "entity": "this",
                  "predicate": {
                    "type": "caverns_and_chasms:oxidized_copper_golem"
                  }
                }
              ],
              "item": {
                "items": "#minecraft:axes"
              }
            },
            "trigger": "minecraft:player_interacted_with_entity"
          }
        }
      },
      {
        "type": "replace",
        "expressed_value": "#map(criteria)",
        "target": "$safe_criteria"
      },
      {
        "type": "replace",
        "expressed_value": "#entries(#map($criteria))",
        "target": "$generic_adding_iterator"
      },
      {
        "type": "loop",
        "remold": [
          {
            "type": "replace",
            "expressed_value": "#nextEntry($generic_adding_iterator)",
            "target": "$next_entry"
          },
          {
            "type": "replace",
            "expressed_value": "#getValue($next_entry)",
            "target": "$safe_criteria[#getKey($next_entry)]"
          }
        ],
        "while": "#hasNext($generic_adding_iterator)"
      },
      {
        "type": "replace",
        "target": "$indexed_requirements",
        "value": [
          {
            "index": 0,
            "replace": false,
            "requirements": [
              "caverns_and_chasms:wax_off_blocks",
              "caverns_and_chasms:wax_off_golem",
              "caverns_and_chasms:wax_off_oxidized_golem"
            ]
          }
        ]
      },
      {
        "type": "conditional",
        "#isList(requirements)": [
          {
            "type": "replace",
            "expressed_value": "#list(requirements)",
            "target": "$requirements"
          },
          {
            "type": "replace",
            "expressed_value": "#size($requirements)",
            "target": "$length"
          },
          {
            "type": "replace",
            "expressed_value": "#elements(#list($indexed_requirements))",
            "target": "$index_requirements_iterator"
          },
          {
            "type": "loop",
            "remold": [
              {
                "type": "replace",
                "expressed_value": "#map((#) #next($index_requirements_iterator))",
                "target": "$entry"
              },
              {
                "type": "replace",
                "expressed_value": "(int) $entry[\"index\"]",
                "target": "$index"
              },
              {
                "type": "conditional",
                "$index < $length": [
                  {
                    "type": "conditional",
                    "$entry[\"replace\"]": {
                      "type": "replace",
                      "expressed_value": "$entry[\"requirements\"]",
                      "target": "$requirements[$index]"
                    },
                    "else": [
                      {
                        "type": "replace",
                        "expressed_value": "#list($requirements[$index])",
                        "target": "$requirements_at_index"
                      },
                      {
                        "type": "replace",
                        "expressed_value": "#elements(#list($entry[\"requirements\"]))",
                        "target": "$generic_adding_iterator"
                      },
                      {
                        "type": "loop",
                        "remold": {
                          "type": "add",
                          "expressed_value": "(#) #next($generic_adding_iterator)",
                          "target": "$requirements_at_index"
                        },
                        "while": "#hasNext($generic_adding_iterator)"
                      }
                    ]
                  }
                ]
              }
            ],
            "while": "#hasNext($index_requirements_iterator)"
          }
        ]
      }
    ]
  ],
  "selector": "minecraft:advancement/husbandry/wax_off"
}